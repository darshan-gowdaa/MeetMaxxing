{
  "manifest_version": 2,
  "name": "MeetMaxxing — AI Meeting Copilot",
  "version": "1.0.2",
  "description": "Real-time AI suggestions, risk flags, and auto-summaries for Google Meet",
  "browser_specific_settings": {
    "gecko": {
      "id": "meetmaxxing@meetmaxxing.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webRequest",
    "https://meet.google.com/*",
    "https://meetmaxxing-api.onrender.com/*"
  ],
  "background": {
    "scripts": ["background.firefox.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles/injected-panel.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://meetmaxxing.vercel.app/extension-auth*",
        "http://localhost:3000/extension-auth*"
      ],
      "js": ["auth-capture.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "MeetMaxxing",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    "assets/*",
    "styles/*",
    "dist/*"
  ]
}
